<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/wCover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Zoomplay"
        android:scaleType="fitCenter"
        android:src="@drawable/logo" />

    <LinearLayout
        android:id="@+id/wInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Zoomplay"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Appuie pour ouvrir"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wPrev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Précédent"
        android:padding="7dp"
        android:src="@drawable/ic_prev" />

    <ImageView
        android:id="@+id/wPlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Lecture ou pause"
        android:padding="7dp"
        android:src="@drawable/ic_play" />

    <ImageView
        android:id="@+id/wNext"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Suivant"
        android:padding="7dp"
        android:src="@drawable/ic_next" />
</LinearLayout>
